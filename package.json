{
  "name": "ecustudio",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/sync-update-runtime.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "setup": "tsx server/setup.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "dev:setup": "node scripts/dev-setup.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:core": "tsx --test tests/pipeline.test.ts tests/accounts-explore.test.ts tests/wechat.test.ts tests/mac-keychain.test.ts tests/chat-materials.test.ts && node --test tests/update-protocol.test.mjs tests/macos-stop.test.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@napi-rs/canvas": "1.1.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "adm-zip": "0.6.1",
    "cheerio": "1.2.0",
    "docx": "9.15.3",
    "fastify": "5.12.8",
    "image-size": "2.1.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.70.0",
    "mammoth": "1.13.0",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.65.0",
    "pptxgenjs": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "image-size": "2.1.0"
  }
}
